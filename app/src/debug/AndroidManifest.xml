<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application>
        <!--
            LeakCanary 2.x 默认通过 ContentProvider 自动安装 AppWatcher；
            GodEye 的 leakcanary 插件也会在主线程手动安装一次。两者同时存在会触发
            "AppWatcher already installed"，所以这里移除自动安装入口，只保留 GodEye 接管。
        -->
        <provider
            android:name="leakcanary.internal.AppWatcherInstaller$MainProcess"
            android:authorities="${applicationId}.leakcanary-installer"
            tools:node="remove" />

        <provider
            android:name="leakcanary.internal.MainProcessAppWatcherInstaller"
            android:authorities="${applicationId}.leakcanary-installer"
            tools:node="remove" />

        <!-- GodEye 旧 manifest 与新版 LeakCanary 对 LeakActivity exported 声明不同，采用新版值。 -->
        <activity
            android:name="leakcanary.internal.activity.LeakActivity"
            android:exported="true"
            tools:replace="android:exported" />

        <!--
            AndroidGodEye 3.x 传递的旧 LeakCanary manifest 中，这个 launcher alias
            带 intent-filter 但没有 android:exported。targetSdk 31+ 必须显式声明。
        -->
        <activity-alias
            android:name="leakcanary.internal.activity.LeakLauncherActivity"
            android:exported="false"
            tools:replace="android:exported" />

        <!--
            LeakCanary 旧版本的 HeapAnalyzerService 会以 ForegroundService 方式分析 hprof，
            但它的 manifest 没有声明 foregroundServiceType。targetSdk 34+ 必须补齐。
        -->
        <service
            android:name="leakcanary.internal.HeapAnalyzerService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            tools:replace="android:exported,android:foregroundServiceType" />
    </application>
</manifest>
