<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- MediaStore 查询图片需要的权限 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:name=".DemoApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_logo"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.HybridDemo">
        <!--
            Sentry SDK 默认会通过 SentryInitProvider 自动初始化，并要求 Manifest 中存在 DSN。
            本 Demo 使用 local.properties / 环境变量注入 DSN 并在 DemoApplication 中手动初始化，
            所以关闭自动初始化，避免未配置 DSN 的开发机启动崩溃。
        -->
        <meta-data
            android:name="io.sentry.auto-init"
            android:value="false" />

        <service
            android:name=".service.bind_ervice.SyncDemoService"
            android:exported="false" />
        <service
            android:name="com.example.hybriddemo.service.bind_ervice.FloatDemoService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />
        <service
            android:name="com.example.hybriddemo.ipc.service.MessengerLongService"
            android:process=":ffmpge"
            android:exported="false"/>

        <activity
            android:name=".mediastore.PhotoPickerDemoActivity"
            android:exported="false" />
        <activity
            android:name=".service.workmanager.WorkManagerDemoActivity"
            android:exported="false" />
        <activity
            android:name=".service.page.ServiceDemoActivity"
            android:exported="false" />
        <activity
            android:name=".xbus.XBusSendActivity"
            android:exported="false"
            android:label="@string/title_activity_xbus_send"
            android:theme="@style/Theme.HybridDemo" />
        <activity
            android:name=".xbus.XBusMainActivity"
            android:exported="false"
            android:label="@string/title_activity_xbus_main"
            android:theme="@style/Theme.HybridDemo" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".flowcompose.FlowComposeActivity" />
        <activity android:name=".historyrelease.ui.HistoryReleaseDataBindingActivity" />
        <activity android:name=".historyrelease.ui.HistoryReleaseViewBindingActivity" />
        <activity android:name=".historyrelease.ui.HistoryReleaseComposeActivity" />
        <activity android:name=".storage.demo.StorageBestPracticeActivity" />
        <activity android:name=".performance.JankOnEnterActivity" />
        <activity android:name=".performance.MemoryLeakDemoActivity" />
        <activity android:name=".sentry.SentryDemoActivity" />
        <activity android:name=".customview.JobSearchCollapseDemoActivity" />
        <activity android:name=".customview.PathAnimationDemoActivity" />
        <activity android:name="com.example.hybriddemo.ipc.ui.IpcDemoActivity" />
    </application>

</manifest>
