<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="FlutterHybridDemo 宿主页面"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenHome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="① 打开 Flutter 首页（主引擎）" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="② 打开 Flutter 详情页（独立引擎 + 传参）" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPushTick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="③ 向所有 Flutter 引擎推 tick 事件" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:padding="8dp"
            android:text="HistoryReleaseFragment 三种原生 UI 方案对比"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenHistoryDataBinding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="④ DataBinding 版本" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenHistoryViewBinding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="⑤ ViewBinding 版本" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenHistoryCompose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="⑥ Compose 版本" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenFlowCompose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="ViewModel + Flow + Compose 示例" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnXbusMain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="展示Xbus" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="展示Service" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWorkManager"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="展示WorkManager媒体上传" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPhotoPicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="展示Photo Picker选图" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnServiceMessenger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="展示进程通讯-Messenger" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenJankOnEnter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="进入页面卡顿示例（主线程反例）" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenMemoryLeakDemo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Memory Profiler 常见内存占用示例" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenJobSearchCollapseDemo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="搜索框上滑收起/下滑展开动画 Demo" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenPathAnimationDemo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="PathMeasure 路径动画 Demo" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenSentryDemo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Sentry 卡顿 / ANR / 崩溃分析 Demo" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenAnrCasesDemo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="ANR 八类场景演示 Demo" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:padding="8dp"
            android:text="Android 本地存储封装规范 Demo"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenStorageBestPractice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="⑦ MMKV / DataStore / Room 封装模板" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:padding="8dp"
            android:text="提示：先点①打开首页，再回到这里点③，可以在首页看到 tick 计数 +1。"
            android:textColor="#666" />

        <TextView
            android:id="@+id/tvAppVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:padding="8dp"
            android:textColor="#999999"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
