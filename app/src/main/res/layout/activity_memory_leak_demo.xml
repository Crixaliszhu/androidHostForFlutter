<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Memory Profiler 内存泄漏示例"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvLeakStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="点击制造泄漏后返回首页，再用 Android Studio Memory Profiler 抓 Heap Dump。"
        android:textColor="#555555"
        android:textSize="15sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCreateLeak"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="制造 Activity 泄漏" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFinishPage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="关闭页面" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnClearLeak"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="清理示例泄漏" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRequestGc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="请求 GC" />

</LinearLayout>
