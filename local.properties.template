# 把当前文件复制为 local.properties 后填入真实路径。
# Android SDK 路径
sdk.dir=/Users/<you>/Library/Android/sdk
# 同级 flutter_module 的绝对路径
flutter.project.dir=/Users/<you>/AndroidStudioProjects/YuPaoProject/FlutterHybridDemo/flutter_module

# Sentry 线上配置。真实值只放 local.properties 或 CI Secret，不提交到仓库。
# DSN 是客户端上报地址，会被打进 APK；Auth Token 只用于构建期上传 mapping，不能进 APK。
SENTRY_DSN=https://<public-key>@<org>.ingest.sentry.io/<project-id>
SENTRY_ORG=crixalis
SENTRY_PROJECT=android
# 需要在 Sentry 后台创建 Organization Auth Token，至少具备 project:releases 相关权限。
SENTRY_AUTH_TOKEN=sntrys_<token-with-project:releases-scope>

# Release 构建默认采样率：Trace 5%，Profile 1%。
# Trace 决定 Performance/Traces 样本量；Profile 决定 CPU 火焰图样本量。
# 如果线上用户量大，建议先从更小值开始，例如 Trace 1%、Profile 0.2%。
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_PROFILES_SAMPLE_RATE=0.01
# 截图和 ViewHierarchy 可能包含用户隐私，线上默认关闭。
SENTRY_ATTACH_SCREENSHOT=false
SENTRY_ATTACH_VIEW_HIERARCHY=false

# 自研质量监控统一上报地址。未配置时事件只会落到 App 私有目录，便于本地查看。
QUALITY_MONITOR_UPLOAD_URL=https://example.com/api/mobile/events/batch

# quality_monitor 已迁移到独立 ServiceModule 项目，Demo 只通过 Maven AAR 依赖。
# 本地验证时指向 ServiceModule 的 publishReleasePublicationToMavenRepository 产物目录。
QUALITY_MONITOR_GROUP_ID=com.example.qualitymonitor
QUALITY_MONITOR_ARTIFACT_ID=quality-monitor
QUALITY_MONITOR_VERSION=1.0.0-SNAPSHOT
QUALITY_MONITOR_REPO_URL=../servicemodule/quality_monitor/build/repo

# Release 签名配置。keystore 和密码不能提交 Git，线上 CI 应放到 Secret。
# RELEASE_STORE_FILE 可以是绝对路径，也可以是相对项目根目录的路径。
RELEASE_STORE_FILE=/Users/<you>/secure/androidHostForFlutter-release.jks
RELEASE_STORE_PASSWORD=<store-password>
RELEASE_KEY_ALIAS=androidHostForFlutter
RELEASE_KEY_PASSWORD=<key-password>
