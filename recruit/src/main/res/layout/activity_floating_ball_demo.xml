<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floatingBallRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F6FC">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:text="View 浮标演示\n拖拽头像、点击头像或关闭图标"
        android:textColor="#303038"
        android:textSize="16sp" />

    <com.example.recruit.ui.FloatingBallLayout
        android:id="@+id/floatingBall"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="16dp" />

    <Button
        android:id="@+id/showFloatingBall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:text="重新显示浮标" />

</FrameLayout>
