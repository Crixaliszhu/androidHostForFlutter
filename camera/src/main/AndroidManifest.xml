<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Camera2 打开 CameraDevice 必须持有 CAMERA 运行时权限。
        Android 6.0+ 需要 Activity 在运行时请求，本模块在 CameraDemoActivity 中处理。
    -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- 定位按钮运行时申请这两个权限，再通过 LocationManager 获取一次当前位置。 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Android 9 及以下写公共相册需要存储权限；Android 10+ 使用 MediaStore 不再需要。 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!--
        required=false 表示“这个功能会用相机，但安装时不强制设备必须有相机”。
        教学 Demo 更适合这样配置：无相机设备仍可安装，只是在页面里展示不可用状态。
    -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <application>
        <!--
            Activity 声明放在业务模块自己的 Manifest 中。
            宿主 app 只要通过 business_bundle 依赖本模块，Manifest 合并和 ARouter 路由表都会进入最终 APK。
        -->
        <activity
            android:name=".CameraDemoActivity"
            android:exported="false"
            android:label="Camera2 开发要点"
            android:theme="@style/Theme.CameraDemo" />
        <activity
            android:name=".WatermarkCameraActivity"
            android:exported="false"
            android:label="水印相机"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.WatermarkCamera" />
    </application>
</manifest>
